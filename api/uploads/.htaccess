# Esta carpeta solo guarda fotos: jamás se debe ejecutar código desde acá.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .phar
RemoveType .php .phtml
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
